# HealthGuard AI Frontend Environment Configuration

# Backend API URL (Use /api for local dev proxy, or https://<your-render-backend-url>/api for production on Vercel)
VITE_API_URL=https://healthguard-ai-backend.onrender.com/api
VITE_API_BASE_URL=https://healthguard-ai-backend.onrender.com/api

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
