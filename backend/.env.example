# HealthGuard AI Backend Environment Configuration

# Application Settings
PROJECT_NAME="HealthGuard AI API"
VERSION="1.0.0"
DEBUG=true
API_V1_STR="/api"

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=healthguard

# JWT Authentication Configuration
JWT_SECRET_KEY=healthguard-ai-change-this-in-production-super-secret-key-928472
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting & Security Configuration
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=15
API_RATE_LIMIT_PER_MINUTE=120

# CORS Allowed Origins (JSON array or comma-separated strings)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
