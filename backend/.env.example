# HealthGuard AI Backend Environment Configuration

# Application Settings
PROJECT_NAME="HealthGuard AI API"
VERSION="1.0.0"
DEBUG=true
API_V1_STR="/api"

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# MongoDB Database Configuration
