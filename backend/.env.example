# HealthGuard AI Backend Environment Configuration

# Application Settings
PROJECT_NAME="HealthGuard AI API"
VERSION="1.0.0"
DEBUG=false
API_V1_STR="/api"

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# Server Network Configuration (Render automatically sets PORT)
HOST=0.0.0.0
PORT=8000

# MongoDB Database Configuration (Use MongoDB Atlas connection string for Render)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=healthguard

# JWT Authentication Configuration
JWT_SECRET_KEY=healthguard-ai-change-this-in-production-super-secret-key-928472
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=true

# Rate Limiting & Security Configuration
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=15
API_RATE_LIMIT_PER_MINUTE=120

# CORS Allowed Origins (Comma-separated or JSON array; supports https://*.vercel.app)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","https://*.vercel.app"]
